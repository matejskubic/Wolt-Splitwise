{
  "name": "wolt-splitwise",
  "version": "0.1.0",
  "private": true,
  "description": "Chromium extension that captures Wolt group order costs and sends them to Splitwise.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:dev": "tsx scripts/build.ts --dev",
    "watch": "tsx scripts/build.ts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pwsh -NoProfile -File scripts/package.ps1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
